# MongoDB 연결 정보 (실제 값으로 변경 후 .env로 저장)
MONGO_USER=your_username
MONGO_PASSWORD=your_password
MONGO_HOST=your_mongodb_host
MONGO_DB=kaim
MONGO_CONNECT_TIMEOUT=120000
MONGO_SOCKET_TIMEOUT=120000

# 데이터 조회 설정
DAYS_TO_LOOK_BACK=2200  # 약 6년치 데이터

# 앙상블 학습 설정
ENSEMBLE_SIZE=3
EPOCHS=100
BATCH_SIZE=32
PATIENCE=10
